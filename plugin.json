{
  "name": "token-moniter-planner",
  "version": "1.0.0",
  "description": "Token Monitor & Planning Studio Plugin for Claude Code",
  "commands": {
    "planning": {
      "source": "./plugin/token-moniter-planner/commands/planning.md",
      "description": "Open the Planning Studio & Dashboard"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/token-moniter-planner/scripts/log-activity.js\""
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/token-moniter-planner/scripts/log-activity.js\""
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/token-moniter-planner/scripts/log-activity.js\""
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/token-moniter-planner/scripts/log-activity.js\""
      }
    ]
  }
}
